// Ispirazione a "Electric Sheep" di Scott Draves (1999)
// Equazioni frattali genetiche con automazione, fusione e animazione organica

let particelle = [];
let numParticelle = 150;
let tempo = 0;

function setup() {
    createCanvas(800, 600);
    colorMode(HSB, 360, 100, 100, 100);
    
    // Genera particelle con "geni" frattali
    for (let i = 0; i < numParticelle; i++) {
        particelle.push({
            x: random(width),
            y: random(height),
            vx: random(-1, 1),
            vy: random(-1, 1),
            // Geni frattali ispirati a flam3/electric sheep
            a: random(0.1, 2.0),
            b: random(0.1, 2.0),
            c: random(0.1, 2.0),
            d: random(0.1, 2.0),
            hue: random(0, 360),
            sat: random(60, 90),
            bri: random(70, 100),
            vita: random(100, 200),
            eta: 0,
            seed: random(1000)
        });
    }
}

function draw() {
    // Sfondo semitrasparente per effetto scia (trails)
    background(0, 0, 0, 10);
    
    tempo = frameCount * 0.01;
    
    // Aggiorna e disegna particelle
    for (let i = 0; i < particelle.length; i++) {
        let p = particelle[i];
        p.eta++;
        
        // Moto basato su funzione frattale di tipo Clarke/Draves
        let nx = sin(p.a * p.x * 0.01 + tempo + p.seed) * cos(p.b * p.y * 0.01);
        let ny = cos(p.c * p.y * 0.01 + tempo * 0.7) * sin(p.d * p.x * 0.01);
        
        // Attrazione verso centro con variazione
        let centroX = width / 2 + sin(tempo * 0.3) * 100;
        let centroY = height / 2 + cos(tempo * 0.2) * 80;
        let dx = centroX - p.x;
        let dy = centroY - p.y;
        let dist = sqrt(dx * dx + dy * dy);
        
        if (dist > 0) {
            nx += (dx / dist) * 0.3;
            ny += (dy / dist) * 0.3;
        }
        
        // Aggiorna velocità e posizione
        p.vx = p.vx * 0.92 + nx * 0.8;
        p.vy = p.vy * 0.92 + ny * 0.8;
        p.x += p.vx;
        p.y += p.vy;
        
        // Wrap around schermo
        if (p.x < 0) p.x = width;
        if (p.x > width) p.x = 0;
        if (p.y < 0) p.y = height;
        if (p.y > height) p.y = 0;
        
        // Evoluzione colore (mimando mutazione genetica di Electric Sheep)
        p.hue = (p.hue + sin(tempo + p.seed) * 2 + 0.5) % 360;
        p.bri = map(sin(tempo * 0.5 + p.eta * 0.01), -1, 1, 60, 100);
        
        // Disegna particella con effetto glow
        noStroke();
        fill(p.hue, p.sat, p.bri, 40);
        ellipse(p.x, p.y, 6, 6);
        
        // Traiettorie connesse (simili a filamenti di campi di forza)
        if (p.eta > 20 && p.eta % 3 == 0) {
            fill(p.hue, p.sat - 20, p.bri, 15);
            ellipse(p.x, p.y, 3, 3);
        }
    }
    
    // Connessioni tra particelle vicine (pattern emergente)
    strokeWeight(0.5);
    for (let i = 0; i < particelle.length; i += 3) {
        let p1 = particelle[i];
        for (let j = i + 3; j < min(i + 15, particelle.length); j += 3) {
            let p2 = particelle[j];
            let d = dist(p1.x, p1.y, p2.x, p2.y);
            if (d < 80) {
                let alpha = map(d, 0, 80, 25, 0);
                stroke((p1.hue + p2.hue) / 2, 80, 90, alpha);
                line(p1.x, p1.y, p2.x, p2.y);
            }
        }
    }
    
    // Evoluzione periodica: "breeding" delle particelle
    if (frameCount % 300 == 0) {
        // Mutazione genetica
        for (let i = 0; i < 10; i++) {
            let idx = floor(random(particelle.length));
            let p = particelle[idx];
            p.a += random(-0.3, 0.3);
            p.b += random(-0.3, 0.3);
            p.c += random(-0.3, 0.3);
            p.d += random(-0.3, 0.3);
            p.hue = random(0, 360);
        }
    }
}




























// Frattale ispirato a "Smaller and Smaller" (1956) di M.C. Escher
// Albero frattale ricorsivo con rotazione e ramificazione in continua riduzione

let angolo = 0;
let profonditaMax = 5;
let lunghezzaBase = 120;
let vento = 0;

// Parametri animazione con reset
let profonditaTarget = 8;
let profonditaCorrente = 8;
let velocitaCrescita = 0.02;
let sogliaReset = 0.1; // quando profonditaCorrente si avvicina a questo valore resetta
let inCrescita = true;

function setup() {
    createCanvas(800, 600);
    angolo = PI / 6; // 30 gradi
    profonditaCorrente = 0; // inizia piccolo
    profonditaTarget = 8;
    inCrescita = true;
}

function draw() {
    background(17);
    
    // Animazione crescita/decrescita con reset
    if (inCrescita) {
        profonditaCorrente += velocitaCrescita;
        if (profonditaCorrente >= profonditaTarget) {
            inCrescita = false;
        }
    } else {
        profonditaCorrente -= velocitaCrescita * 1.2;
        if (profonditaCorrente <= sogliaReset) {
            // Reset: riavvia dal piccolo
            profonditaCorrente = 2;
            inCrescita = true;
            // Varia leggermente gli angoli per varietà
            angolo = PI / 6 + random(-0.05, 0.05);
        }
    }
    
    // Movimento oscillatorio ispirato al continuo restringimento di Escher
    vento = sin(frameCount * 0.01) * 0.08;
    
    // Tronco
    stroke(139, 115, 85);
    strokeWeight(8);
    translate(width / 2, height);
    
    // Disegna albero frattale con profondità animata
    branch(lunghezzaBase, 0, profonditaCorrente);
}

function branch(len, prof, maxProf) {
    // Riduzione progressiva della lunghezza (chiave del pattern escheriano)
    let nuovaLen = len * 0.7;
    let peso = map(prof, 0, maxProf, 4, 0.5);
    
    strokeWeight(peso);
    
    // Colore che si schiarisce verso le foglie
    if (prof < 3) {
        stroke(139, 115, 85); // tronco/rami spessi
    } else if (prof < 7) {
        stroke(110, 140, 90); // rami medi
    } else {
        stroke(120, 180, 100); // ramificazioni/foglie
    }
    
    line(0, 0, 0, -len);
    translate(0, -len);
    
    if (prof < maxProf) {
        // Due rami con angoli asimmetrici per maggiore organicità
        push();
        rotate(angolo + vento);
        branch(nuovaLen, prof + 1, maxProf);
        pop();
        
        push();
        rotate(-angolo * 0.8 - vento * 0.5);
        branch(nuovaLen * 0.9, prof + 1, maxProf);
        pop();
        
        // Terzo ramo sottile per maggiore complessità frattale
        if (prof < maxProf - 2 && prof > 1) {
            push();
            rotate(vento * 2);
            branch(nuovaLen * 0.7, prof + 1, maxProf);
            pop();
        }
    }
    
    translate(0, len);
}
